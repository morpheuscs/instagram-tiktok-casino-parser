# Учётные данные для парсинга (скопируйте в .env и заполните своими значениями)
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
TIKTOK_USERNAME=
TIKTOK_PASSWORD=

# Включение/отключение платформ (1 = вкл, 0 = выкл)
ENABLE_INSTAGRAM=1
ENABLE_TIKTOK=1

# Лимиты парсинга
MAX_VIDEOS_PER_KEYWORD=15
MAX_ITEMS_PER_TAG=50
PARALLEL_WORKERS=5

# Ротация IP через OpenVPN (опционально, для Linux)
ENABLE_VPN_ROTATION=0
VPN_CONFIG_FILE=
VPN_CREDS_FILE=
